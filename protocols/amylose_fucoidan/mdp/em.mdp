; Human-written carb energy-minimization (smoke-test).
; Protocol: amylose26_fucoidan12. Default short chain, not 200 ns.
; Do not generate or replace this file from model output.
; Allowlisted overrides: nsteps (dt / ref_t unused here).

integrator              = steep
nsteps                  = 500
emtol                   = 1000.0
emstep                  = 0.01
nstxout                 = 100
nstvout                 = 0
nstfout                 = 0
nstenergy               = 50
nstlog                  = 50
cutoff-scheme           = Verlet
ns_type                 = grid
nstlist                 = 10
coulombtype             = cutoff
rcoulomb                = 1.2
rvdw                    = 1.2
pbc                     = xyz
constraints             = none
energygrps              = Amylose Fucoidan
