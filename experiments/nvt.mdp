; Human-written short NVT template (smoke-test default).
; Not the 100 ns production run (see experiments/md.mdp).
; Do not generate or replace this file from model output.
; Allowlisted overrides: nsteps, dt, ref_t (scalars only).

integrator              = md
nsteps                  = 500
dt                      = 0.001
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstenergy               = 50
nstlog                  = 50
nstxout-compressed      = 50
compressed-x-grps       = System
continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4
cutoff-scheme           = Verlet
ns_type                 = grid
nstlist                 = 10
rvdw                    = 1.2
rcoulomb                = 1.2
coulombtype             = cutoff
tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 1.0
ref_t                   = 298
pcoupl                  = no
pbc                     = xyz
gen_vel                 = yes
gen_temp                = 298
gen_seed                = 42
